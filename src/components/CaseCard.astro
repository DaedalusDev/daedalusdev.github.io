---
import { render, type CollectionEntry } from 'astro:content'
import { ui } from '../i18n'

const { entry } = Astro.props as { entry: CollectionEntry<'cases'> }
const { title, role, period, summary, stack, demo, lang } = entry.data
const { Content } = await render(entry)
---
<article class="case">
  <h3>{title}</h3>
  <p class="meta">{role} · {period}</p>
  <p class="summary">{summary}</p>
  <div class="prose"><Content /></div>
  {stack.length > 0 && <p class="stack">{stack.join(' · ')}</p>}
  {demo && <p><a class="button" href={demo}>{ui[lang].play}</a></p>}
</article>
